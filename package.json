{
  "name": "mampokoj",
  "version": "0.8.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate --config=drizzle.config.tsx",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.tsx",
    "db:baseline": "tsx src/utils/baseline.tsx",
    "db:push": "drizzle-kit push --config=drizzle.config.tsx",
    "db:seed": "tsx src/utils/seed.tsx",
    "db:studio": "drizzle-kit studio --config=drizzle.config.tsx"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-form": "^0.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@uploadthing/react": "^7.3.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "drizzle-orm": "^0.45.2",
    "js-cookie": "^3.0.8",
    "motion": "^12.40.0",
    "next": "16.3.6",
    "next-auth": "^4.24.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "styled-components": "^6.5.3",
    "uploadthing": "^7.7.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "tsx": "^4.22.1",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
